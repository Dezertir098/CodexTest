{
  "name": "dark-world-russian",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run src",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "tutor": "node server/tutor.mjs",
    "format": "prettier --write src server e2e *.ts *.json index.html README.md",
    "desktop": "npm run build && electron .",
    "desktop:pack:win": "npm run build && electron-builder --win portable --x64 --publish never",
    "desktop:test": "node desktop/security.test.cjs",
    "desktop:smoke": "node scripts/desktop-smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "main": "desktop/main.cjs",
  "description": "Личная офлайн-подготовка по русскому языку: уроки, практика и повторение",
  "author": "Dezertir098"
}
